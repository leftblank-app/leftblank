@@ -617,6 +618,25 @@ impl EntryMap {
         }
     }
 
+    /// Gives unread entries cells of their own. Otherwise a reader that still
+    /// holds the previous revision can fill a cell shared with the next
+    /// revision after its path index was copied, so the next revision keeps
+    /// stale content that no later path invalidation can find.
+    fn detach_unread(&mut self) {
+        let unread: Vec<EntryId> = self
+            .entries
+            .iter()
+            .filter(|(_, entry)| entry.bytes.get().is_none())
+            .map(|(id, _)| *id)
+            .collect();
+        for id in unread {
+            if let Some(entry) = self.entries.get_mut(&id) {
+                entry.bytes = Arc::default();
+                entry.source = Arc::default();
+            }
+        }
+    }
+
     fn get_mut(&mut self, id: FileId) -> Option<&mut VfsEntry> {
         self.entries.get_mut(&Self::key(id))
     }
